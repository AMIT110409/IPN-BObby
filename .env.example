# ──────────────────────────────────────────────────────────────────────────────
# Bobby — Root .env.example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── Environment mode ──────────────────────────────────────────────────────────
# "demo"       → uses Supabase + OpenAI (direct)
# "production" → uses Azure OpenAI + Azure AI Search + Azure PostgreSQL
APP_ENV=demo

# ── LLM ───────────────────────────────────────────────────────────────────────
# Demo (OpenAI direct)
OPENAI_API_KEY=sk-...

# Production (Azure OpenAI) — only needed when APP_ENV=production
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Supabase (demo database + vector store) ───────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Azure PostgreSQL (production) ─────────────────────────────────────────────
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_DB=bobby
AZURE_POSTGRES_USER=
AZURE_POSTGRES_PASSWORD=
AZURE_POSTGRES_PORT=5432

# ── Azure AI Search (production vector store) ─────────────────────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=bobby-knowledge

# ── Freshdesk ─────────────────────────────────────────────────────────────────
FRESHDESK_API_KEY=your_freshdesk_api_key
FRESHDESK_DOMAIN=yourcompany.freshdesk.com   # e.g. acme.freshdesk.com

# ── Microsoft Graph API (account management) ──────────────────────────────────
# Leave blank for demo — account features will be stubbed
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Langfuse (observability) ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com    # or your self-hosted URL

# ── Backend ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production      # used for demo JWT signing
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# These go in frontend/.env (prefixed VITE_)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Bobby
